#!/bin/sh
set -eu
tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-history-package-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT INT TERM
package="$tmp/package"
mkdir -p "$package" "$tmp/default-prefix" "$tmp/optional-prefix" "$tmp/home" "$tmp/share/agent-history/plugin" "$tmp/bin" "$tmp/out"
printf '#!/bin/sh\ncase "$1" in -s) echo Darwin ;; -m) echo arm64 ;; esac\n' > "$tmp/bin/uname"
chmod 755 "$tmp/bin/uname"
cp scripts/install scripts/uninstall "$package/"
for name in agent-history agent-history-overlay; do
  printf '#!/bin/sh\n' > "$package/$name"
  chmod 755 "$package/$name"
done

# A base artifact may omit every Herdr-specific file.
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/install" "$tmp/default-prefix" >/dev/null
test -x "$tmp/default-prefix/agent-history"
test -x "$tmp/default-prefix/agent-history-overlay"
test ! -e "$tmp/default-prefix/agent-history-herdr"
test ! -e "$tmp/share/agent-history/plugin/herdr-plugin.toml"

# Opt-in accepts either argument order and requires both optional artifacts.
if PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/install" --with-herdr "$tmp/optional-prefix" >/dev/null 2>&1; then exit 1; fi
printf '#!/bin/sh\n' > "$package/agent-history-herdr"
chmod 755 "$package/agent-history-herdr"
if PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/install" --with-herdr "$tmp/optional-prefix" >/dev/null 2>&1; then exit 1; fi
mkdir -p "$package/plugin/agent-history"
printf 'id = "agent-history"\n' > "$package/plugin/agent-history/herdr-plugin.toml"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/install" "$tmp/optional-prefix" --with-herdr >/dev/null
test -x "$tmp/optional-prefix/agent-history-herdr"
test -f "$tmp/share/agent-history/plugin/herdr-plugin.toml"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/uninstall" "$tmp/optional-prefix" >/dev/null
test ! -e "$tmp/optional-prefix/agent-history-herdr"
test ! -e "$tmp/share/agent-history/plugin/herdr-plugin.toml"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/install" --with-herdr "$tmp/optional-prefix" >/dev/null
test -x "$tmp/optional-prefix/agent-history-herdr"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/uninstall" "$tmp/optional-prefix" >/dev/null
test ! -e "$tmp/optional-prefix/agent-history-herdr"

printf unrelated > "$tmp/default-prefix/keep"
printf native > "$tmp/native-history"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/uninstall" "$tmp/default-prefix" >/dev/null
test -f "$tmp/default-prefix/keep"
test "$(cat "$tmp/native-history")" = native

# Uninstall removes the agent-history directories the installer created once
# they are empty, and nothing above them: share/ and the prefix are shared with
# other software. The index and native history are never touched.
tree="$tmp/tree"
index="$tmp/home/Library/Application Support/Herdr Agent History/index.sqlite"
mkdir -p "$tree" "$(dirname "$index")"
printf index > "$index"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/install" --with-herdr "$tree/bin" >/dev/null
test -f "$tree/share/agent-history/plugin/herdr-plugin.toml"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/uninstall" "$tree/bin" > "$tmp/uninstall.out"
grep -q "removed empty directory $tree/bin/../share/agent-history/plugin" "$tmp/uninstall.out"
test ! -e "$tree/share/agent-history"
test -d "$tree/share"
test -d "$tree/bin"
test -z "$(ls -A "$tree/bin")"
test "$(cat "$index")" = index
test "$(cat "$tmp/native-history")" = native
# Anything else in those directories keeps them, and is kept.
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/install" --with-herdr "$tree/bin" >/dev/null
printf mine > "$tree/share/agent-history/plugin/notes"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/uninstall" "$tree/bin" >/dev/null
test ! -e "$tree/share/agent-history/plugin/herdr-plugin.toml"
test "$(cat "$tree/share/agent-history/plugin/notes")" = mine
rm "$tree/share/agent-history/plugin/notes"
printf mine > "$tree/share/agent-history/notes"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/uninstall" "$tree/bin" >/dev/null
test ! -e "$tree/share/agent-history/plugin"
test "$(cat "$tree/share/agent-history/notes")" = mine
# A symlinked directory is not the installer's; neither it nor its target goes.
rm -r "$tree/share/agent-history"
mkdir -p "$tmp/elsewhere"
ln -s "$tmp/elsewhere" "$tree/share/agent-history"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/uninstall" "$tree/bin" >/dev/null
test -L "$tree/share/agent-history"
test -d "$tmp/elsewhere"
rm "$tree/share/agent-history"
# Uninstalling twice, or from a prefix that never had an install, is harmless.
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/uninstall" "$tree/bin" >/dev/null
test -d "$tree/share"
test "$(cat "$index")" = index

if PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/install" --unknown "$tmp/default-prefix" >/dev/null 2>&1; then exit 1; fi
if sh "$package/uninstall" relative >/dev/null 2>&1; then exit 1; fi

# Reinstalling over an existing install must replace the binary by rename, not
# write through the inode: macOS kills a binary whose signature no longer matches
# the pages it already mapped, so an in-place overwrite only breaks on upgrade
# and never on a clean install.
reinstall_prefix="$tmp/reinstall-prefix"
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/install" "$reinstall_prefix" >/dev/null
first_inode=$(ls -i "$reinstall_prefix/agent-history" | awk '{print $1}')
PATH="$tmp/bin:$PATH" HOME="$tmp/home" sh "$package/install" "$reinstall_prefix" >/dev/null
second_inode=$(ls -i "$reinstall_prefix/agent-history" | awk '{print $1}')
test "$first_inode" != "$second_inode"
test -x "$reinstall_prefix/agent-history"
# No temporary file is left behind by either install.
test -z "$(find "$reinstall_prefix" -name '*.install.*' -print -quit)"

# Packaging refuses to overwrite an existing archive and preserves neighbors.
printf marker > "$tmp/out/keep"
printf old > "$tmp/out/agent-history-macos-arm64.tar.gz"
if PATH="$tmp/bin:$PATH" env -u AGENT_HISTORY_SIGN_IDENTITY -u AGENT_HISTORY_NOTARY_PROFILE sh scripts/package "$tmp/out" >/dev/null 2>&1; then exit 1; fi
test "$(cat "$tmp/out/keep")" = marker
test "$(cat "$tmp/out/agent-history-macos-arm64.tar.gz")" = old

# Signing and notarization run against a synthetic source tree whose build,
# quality gate and Apple tools are stubs that record their arguments. Nothing
# here touches a keychain or contacts Apple.
repo=$(pwd)
src="$tmp/src"
stubs="$tmp/stubs"
calls="$tmp/calls"
mkdir -p "$src/scripts" "$src/docs" "$src/plugin/agent-history" "$stubs"
cp scripts/install scripts/uninstall "$src/scripts/"
printf readme > "$src/README.md"
printf agents > "$src/AGENTS.md"
printf doc > "$src/docs/NOTE.md"
printf 'id = "agent-history"\n' > "$src/plugin/agent-history/herdr-plugin.toml"
printf 'target/\n' > "$src/.gitignore"
git_src() { git -C "$src" -c user.name=test -c user.email=test@example.invalid -c commit.gpgsign=false -c tag.gpgsign=false "$@"; }
git_src init -q
git_src add -A
git_src commit -q -m synthetic
git_src tag v0.1.0-rc.9
cp "$tmp/bin/uname" "$stubs/uname"
stub() {
  printf '#!/bin/sh\necho "%s $*" >> "%s"\n%s\n' "$1" "$calls" "$2" > "$stubs/$1"
  chmod 755 "$stubs/$1"
}
printf '#!/bin/sh\necho "check" >> "%s"\n' "$calls" > "$src/scripts/check"
chmod 755 "$src/scripts/check"
# The cargo stub bakes the identifier it was given into agent-history
# --version, unless STUB_VERSION_ID stands in for a build that ignored it.
cat > "$stubs/cargo" <<EOF
#!/bin/sh
echo "cargo \$*" >> "$calls"
echo "build-id \${AGENT_HISTORY_BUILD_ID-unset}" >> "$calls"
mkdir -p target/release
for n in agent-history-overlay agent-history-herdr; do printf '#!/bin/sh\n' > target/release/\$n; chmod 755 target/release/\$n; done
printf '#!/bin/sh\necho "agent-history 0.1.0 (%s)"\n' "\${STUB_VERSION_ID-\$AGENT_HISTORY_BUILD_ID}" > target/release/agent-history
chmod 755 target/release/agent-history
EOF
chmod 755 "$stubs/cargo"
stub security 'echo "  1) 0000 \"${STUB_IDENTITY:-Developer ID Application: Test (TEAMID0000)}\""'
stub codesign 'case "$1" in -dvv) echo "Authority=${STUB_AUTHORITY:-Developer ID Application: Test (TEAMID0000)}" >&2 ;; -dv) echo "CodeDirectory v=20500 flags=0x10000(runtime)" >&2 ;; esac'
stub xcrun 'case "$2" in
  history) exit "${STUB_HISTORY_EXIT:-0}" ;;
  submit) printf "{\"id\":\"sub-1\",\"status\":\"%s\"}\n" "${STUB_NOTARY_STATUS:-Accepted}"; exit "${STUB_SUBMIT_EXIT:-0}" ;;
  log) echo "synthetic notary log" ;;
esac'
stub spctl 'echo "$4: ${STUB_SPCTL:-accepted}" >&2; echo "source=Notarized Developer ID" >&2'
# Arguments are environment assignments for this run only.
package_run() {
  rm -rf "$src/target" "$tmp/dist" "$calls"
  : > "$calls"
  (cd "$src" && env -u AGENT_HISTORY_SIGN_IDENTITY -u AGENT_HISTORY_NOTARY_PROFILE -u AGENT_HISTORY_BUILD_ID PATH="$stubs:$PATH" "$@" \
    sh "$repo/scripts/package" "$tmp/dist" > "$tmp/stdout" 2> "$tmp/stderr")
}
calls_to() { grep -c -E "^$1( |\$)" "$calls" || true; }

# Without an identity the archive is built ad-hoc and says so loudly; no Apple
# tool is invoked.
package_run
test -f "$tmp/dist/agent-history-macos-arm64.tar.gz"
(cd "$tmp/dist" && shasum -a 256 -c agent-history-macos-arm64.tar.gz.sha256 >/dev/null)
grep -q 'ad-hoc signed and NOT notarized' "$tmp/stderr"
test "$(tail -n 1 "$tmp/stdout")" = "signing: ad-hoc only, NOT notarized"
test "$(calls_to codesign)" = 0
test "$(calls_to xcrun)" = 0
test "$(calls_to check)" = 1
test "$(tar -tzf "$tmp/dist/agent-history-macos-arm64.tar.gz" | grep -c -E '^agent-history/agent-history(-overlay|-herdr)?$')" = 3

# The release tag is stamped into the build, and the built binary must report it.
grep -q '^build-id v0.1.0-rc.9$' "$calls"
grep -q '^package: agent-history 0.1.0 (v0.1.0-rc.9)$' "$tmp/stdout"
tar -xzf "$tmp/dist/agent-history-macos-arm64.tar.gz" -C "$tmp" agent-history/agent-history
test "$("$tmp/agent-history/agent-history" --version)" = "agent-history 0.1.0 (v0.1.0-rc.9)"
# An explicit identifier wins over git.
package_run AGENT_HISTORY_BUILD_ID=v0.1.0-rc.10
grep -q '^build-id v0.1.0-rc.10$' "$calls"
# A commit after the tag, and uncommitted changes, are both visible.
printf changed > "$src/README.md"
package_run
grep -q '^build-id v0.1.0-rc.9-dirty$' "$calls"
git_src commit -q -am next
package_run
grep -q "^build-id v0.1.0-rc.9-1-g$(git_src rev-parse --short HEAD)\$" "$calls"
# A checkout with no tag at all still packages, identified by its commit.
git_src tag -d v0.1.0-rc.9 >/dev/null
package_run
grep -q "^build-id $(git_src rev-parse --short HEAD)\$" "$calls"
# Outside git and without an identifier, or with an unsafe one, nothing is built.
if package_run GIT_DIR="$tmp/no-such-git"; then exit 1; fi
grep -q 'cannot identify this build' "$tmp/stderr"
test "$(calls_to check)" = 0
if package_run AGENT_HISTORY_BUILD_ID='v1 $(touch pwned)'; then exit 1; fi
grep -q 'may contain only letters' "$tmp/stderr"
test "$(calls_to check)" = 0
test ! -e "$src/pwned"
# A build that did not pick the identifier up is refused rather than shipped.
if package_run STUB_VERSION_ID=; then exit 1; fi
grep -q 'not build ' "$tmp/stderr"
test ! -e "$tmp/dist/agent-history-macos-arm64.tar.gz"
git_src tag v0.1.0-rc.9

# A notary profile without an identity is refused before any build.
if package_run AGENT_HISTORY_NOTARY_PROFILE=release; then exit 1; fi
grep -q 'needs AGENT_HISTORY_SIGN_IDENTITY' "$tmp/stderr"
test "$(calls_to check)" = 0
test ! -e "$tmp/dist/agent-history-macos-arm64.tar.gz"

# An identity that is missing, or not a Developer ID Application, is refused.
if package_run AGENT_HISTORY_SIGN_IDENTITY="Developer ID Application: Other"; then exit 1; fi
if package_run STUB_IDENTITY="Apple Development: Test (TEAMID0000)" AGENT_HISTORY_SIGN_IDENTITY=TEAMID0000; then exit 1; fi
test "$(calls_to check)" = 0

# An unusable notary profile is refused before any build.
if package_run STUB_HISTORY_EXIT=1 AGENT_HISTORY_SIGN_IDENTITY=TEAMID0000 AGENT_HISTORY_NOTARY_PROFILE=missing; then exit 1; fi
grep -q 'cannot use keychain profile "missing"' "$tmp/stderr"
test "$(calls_to check)" = 0

# Identity alone signs every binary with a hardened runtime and a timestamp,
# but warns that the result is still quarantined.
package_run AGENT_HISTORY_SIGN_IDENTITY=TEAMID0000
test "$(grep -c '^codesign --force --sign TEAMID0000 --options runtime --timestamp ' "$calls")" = 3
test "$(grep -c '^codesign --verify --strict ' "$calls")" = 3
grep -q 'signed with Developer ID but NOT notarized' "$tmp/stderr"
test "$(tail -n 1 "$tmp/stdout")" = "signing: Developer ID signed, NOT notarized"
test "$(grep -c '^xcrun notarytool submit' "$calls")" = 0

# A signature from another certificate type is rejected after signing.
if package_run STUB_AUTHORITY="Apple Distribution: Test (TEAMID0000)" AGENT_HISTORY_SIGN_IDENTITY=TEAMID0000; then exit 1; fi
grep -q 'not signed by a Developer ID Application certificate' "$tmp/stderr"
test ! -e "$tmp/dist/agent-history-macos-arm64.tar.gz"

# Identity and profile submit a zip by profile name, then require Gatekeeper
# to accept every binary as notarized.
package_run AGENT_HISTORY_SIGN_IDENTITY=TEAMID0000 AGENT_HISTORY_NOTARY_PROFILE=release
grep -q '^xcrun notarytool submit .*/notarize.zip --keychain-profile release --wait --output-format json$' "$calls"
test "$(calls_to spctl)" = 3
test "$(tail -n 1 "$tmp/stdout")" = "signing: Developer ID signed and notarized by Apple; Gatekeeper allows a quarantined copy after an online check"
test ! -s "$tmp/stderr"
test -f "$tmp/dist/agent-history-macos-arm64.tar.gz"

# A rejected submission prints Apple's log and leaves no archive, whether
# notarytool reports it through its status or its exit code.
if package_run STUB_NOTARY_STATUS=Invalid AGENT_HISTORY_SIGN_IDENTITY=TEAMID0000 AGENT_HISTORY_NOTARY_PROFILE=release; then exit 1; fi
grep -q 'notarization failed (status: Invalid' "$tmp/stderr"
grep -q 'synthetic notary log' "$tmp/stderr"
test ! -e "$tmp/dist/agent-history-macos-arm64.tar.gz"
if package_run STUB_NOTARY_STATUS=Accepted STUB_SUBMIT_EXIT=1 AGENT_HISTORY_SIGN_IDENTITY=TEAMID0000 AGENT_HISTORY_NOTARY_PROFILE=release; then exit 1; fi
grep -q 'notarytool exit 1' "$tmp/stderr"
test ! -e "$tmp/dist/agent-history-macos-arm64.tar.gz"

# So does a Gatekeeper rejection after an accepted submission.
if package_run STUB_SPCTL=rejected AGENT_HISTORY_SIGN_IDENTITY=TEAMID0000 AGENT_HISTORY_NOTARY_PROFILE=release; then exit 1; fi
grep -q 'Gatekeeper does not accept notarized agent-history' "$tmp/stderr"
test ! -e "$tmp/dist/agent-history-macos-arm64.tar.gz"
echo "packaging smoke passed"
