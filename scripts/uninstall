#!/bin/sh
set -eu
prefix="${1:-$HOME/.local/bin}"
for name in agent-history agent-history-overlay; do
  path="$prefix/$name"
  if [ -e "$path" ]; then
    rm -f "$path"
    echo "removed $path"
  fi
done
plugin_dir="$prefix/../share/agent-history/plugin"
if [ -f "$plugin_dir/herdr-plugin.toml" ]; then
  rm -f "$plugin_dir/herdr-plugin.toml"
fi
echo "Native histories and index retained. In Herdr: herdr plugin unlink agent-history"
